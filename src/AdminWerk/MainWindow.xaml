<Window x:Class="AdminWerk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AdminWerk.ViewModels"
        xmlns:views="clr-namespace:AdminWerk.Views"
        Title="AdminWerk – Windows Administration Suite"
        Icon="Themes/adminwerk.ico"
        Height="840" Width="1320"
        MinHeight="640" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Flaeche.Fenster}"
        FontFamily="{StaticResource Schrift.Oberflaeche}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.DataContext>
        <vm:HauptViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolZuSichtbarkeit" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding FavoritUmschaltenBefehl}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Kopfbereich: Titel, Untertitel, Suche ============ -->
        <Border Grid.Row="0" Background="{StaticResource Flaeche.Kopf}" Padding="28,22,28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="34" FontWeight="Bold">
                        <Run Text="Admin" Foreground="{StaticResource Text.Primaer}" />
                        <Run Text="Werk" Foreground="{StaticResource Akzent.Primaer}" />
                    </TextBlock>
                    <TextBlock Text="Windows Administration Suite"
                               Margin="2,2,0,0"
                               FontSize="14"
                               Foreground="{StaticResource Text.Sekundaer}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="300" Margin="0,0,10,0">
                        <TextBox Style="{StaticResource Suchfeld}"
                                 AutomationProperties.Name="Skripte durchsuchen"
                                 Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                        <TextBlock Text="Skripte durchsuchen …"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource Text.Gedaempft}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Suchbegriff}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Content="Skriptordner"
                            Style="{StaticResource Schaltflaeche.Sekundaer}"
                            Command="{Binding SkriptordnerOeffnenBefehl}"
                            ToolTip="Verzeichnis mit den .ps1-Dateien im Explorer öffnen"
                            Margin="0,0,8,0" />
                    <Button Content="Neu laden"
                            Style="{StaticResource Schaltflaeche.Sekundaer}"
                            Command="{Binding NeuLadenBefehl}"
                            ToolTip="Skriptkatalog erneut von der Festplatte einlesen" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Kategorie-Navigation ============ -->
        <Border Grid.Row="1"
                Background="{StaticResource Flaeche.Kopf}"
                BorderBrush="{StaticResource Linie.Standard}"
                BorderThickness="0,0,0,1"
                Padding="22,0,22,0">
            <ListBox Style="{StaticResource Kategorieleiste}"
                     AutomationProperties.Name="Kategorien"
                     ItemsSource="{Binding Kategorien}"
                     SelectedItem="{Binding AusgewaehlteKategorie}" />
        </Border>

        <!-- ============ Fehlerhinweis ============ -->
        <Border Grid.Row="2"
                Background="#2A1A1A"
                BorderBrush="{StaticResource Akzent.Fehler}"
                BorderThickness="0,0,0,1"
                Padding="28,12"
                Visibility="{Binding HatLadefehler, Converter={StaticResource BoolZuSichtbarkeit}}">
            <TextBlock Text="{Binding Ladefehler}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Akzent.Fehler}" />
        </Border>

        <!-- ============ Inhalt: Liste + Detail ============ -->
        <Grid Grid.Row="3" Margin="22,18,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Skriptliste -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                    <TextBlock Text="{Binding AusgewaehlteKategorie.Name}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text.Primaer}" />
                    <TextBlock Text="{Binding AusgewaehlteKategorie.Beschreibung}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource Text.Gedaempft}" />
                </StackPanel>

                <!-- Hinweis, solange die Ansicht leer ist (z. B. noch keine Favoriten). -->
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding Leermeldung}"
                           Margin="4,24,4,0"
                           FontSize="13"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Text.Gedaempft}"
                           Visibility="{Binding KeineTreffer, Converter={StaticResource BoolZuSichtbarkeit}}" />

                <ListBox Style="{StaticResource Skriptliste}"
                         AutomationProperties.Name="Skripte der gewaehlten Kategorie"
                         ItemsSource="{Binding GefilterteSkripte}"
                         SelectedItem="{Binding AusgewaehltesSkript}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Der Haken sammelt fuer das naechste Pruefpaket; der Stern
                                     rechts merkt sich dauerhaft. Zwei Dinge, zwei Marken. -->
                                <CheckBox Grid.Column="0"
                                          Style="{StaticResource Schalter}"
                                          IsChecked="{Binding ImPaket}"
                                          Margin="0,1,11,0"
                                          VerticalAlignment="Top"
                                          AutomationProperties.Name="{Binding Titel, StringFormat=Ins Prüfpaket: {0}}"
                                          ToolTip="Für das Prüfpaket auswählen" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Titel}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Text.Primaer}" />
                                    <TextBlock Text="{Binding Beschreibung}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               MaxHeight="34"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource Text.Gedaempft}" />
                                    <TextBlock Text="{Binding TagZeile}"
                                               FontSize="11"
                                               Margin="0,7,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource Akzent.Hell}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Style="{StaticResource Schaltflaeche.Stern}"
                                        Command="{Binding DataContext.FavoritUmschaltenBefehl, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Detailansicht -->
            <Border Grid.Column="2"
                    Background="{StaticResource Flaeche.Karte}"
                    BorderBrush="{StaticResource Linie.Standard}"
                    BorderThickness="1"
                    CornerRadius="8">

                <!-- Visibility bewusst gegen das Fenster gebunden: der DataContext dieses Grids
                     ist das ausgewaehlte Skript und damit null, sobald nichts ausgewaehlt ist. -->
                <Grid DataContext="{Binding AusgewaehltesSkript}"
                      Visibility="{Binding DataContext.HatAuswahl,
                                           RelativeSource={RelativeSource AncestorType=Window},
                                           Converter={StaticResource BoolZuSichtbarkeit}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="22,20,22,14">
                        <TextBlock Text="{Binding Titel}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource Text.Primaer}" />
                        <TextBlock Text="{Binding Beschreibung}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource Text.Sekundaer}" />

                        <WrapPanel Margin="0,14,0,0">
                            <Border Style="{StaticResource Kennzeichen}" Margin="0,0,7,7">
                                <TextBlock Style="{StaticResource Kennzeichen.Text}" Text="{Binding KategorieName}" />
                            </Border>
                            <Border Margin="0,0,7,7">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Kennzeichen}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdminRechte}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Akzent.Warnung}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RechteText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Kennzeichen.Text}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AdminRechte}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Akzent.Warnung}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource Kennzeichen}" Margin="0,0,7,7">
                                <TextBlock Style="{StaticResource Kennzeichen.Text}" Text="{Binding Voraussetzung}" />
                            </Border>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="In Zwischenablage kopieren"
                                    Style="{StaticResource Schaltflaeche.Primaer}"
                                    Command="{Binding DataContext.KopierenBefehl, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,0,8,0" />
                            <Button Content="Als .ps1 speichern"
                                    Style="{StaticResource Schaltflaeche.Sekundaer}"
                                    Command="{Binding DataContext.SpeichernBefehl, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,0,8,0" />
                            <Button Content="In PowerShell öffnen"
                                    Style="{StaticResource Schaltflaeche.Sekundaer}"
                                    Command="{Binding DataContext.InPowerShellOeffnenBefehl, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Öffnet eine Sitzung im Skriptverzeichnis und legt den Aufruf bereit. Ausgeführt wird nichts."
                                    Margin="0,0,8,0" />
                            <Button Content="{Binding FavoritText}"
                                    Style="{StaticResource Schaltflaeche.Favorit}"
                                    Command="{Binding DataContext.FavoritUmschaltenBefehl, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Strg+D" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ============ Parameterassistent ============ -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Flaeche.Kopf}"
                            BorderBrush="{StaticResource Linie.Standard}"
                            BorderThickness="0,1,0,0"
                            Padding="22,14,22,14"
                            Visibility="{Binding DataContext.HatParameter,
                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                 Converter={StaticResource BoolZuSichtbarkeit}}">
                        <!-- Zugeklappt: der Quelltext ist der Hauptinhalt der Detailansicht und
                             soll nicht schon beim Auswaehlen eines Skripts verdraengt werden.
                             Die Kopfzeile nennt die Anzahl und laedt zum Aufklappen ein. -->
                        <Expander Style="{StaticResource Parameterbereich}"
                                  IsExpanded="False"
                                  Header="{Binding DataContext.ParameterUeberschrift,
                                                   RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel>
                                <!-- Eng begrenzt: bei sieben Parametern draengt die Liste sonst
                                     den Quelltext vollstaendig aus dem Fenster. -->
                                <ScrollViewer MaxHeight="150"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding DataContext.Parameter,
                                                                       RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Margin="0,0,8,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding Anzeigename}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource Text.Primaer}" />
                                                        <TextBlock Text="{Binding Hinweis}"
                                                                   FontSize="11"
                                                                   Margin="0,3,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource Text.Gedaempft}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <!-- Ueber dem Feld, nicht darunter: sonst liest sich der
                                                             Text wie die Erlaeuterung des naechsten Parameters. -->
                                                        <TextBlock Text="{Binding Beschreibung}"
                                                                   FontSize="11.5"
                                                                   Margin="0,0,0,5"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource Text.Sekundaer}"
                                                                   Visibility="{Binding HatBeschreibung, Converter={StaticResource BoolZuSichtbarkeit}}" />

                                                        <CheckBox Style="{StaticResource Schalter}"
                                                                  Content="{Binding Name, StringFormat=-{0} setzen}"
                                                                  IsChecked="{Binding Gesetzt}"
                                                                  AutomationProperties.Name="{Binding Name}"
                                                                  Margin="0,3,0,0"
                                                                  Visibility="{Binding IstSchalter, Converter={StaticResource BoolZuSichtbarkeit}}" />

                                                        <ComboBox Style="{StaticResource Auswahlfeld}"
                                                                  ItemsSource="{Binding ErlaubteWerte}"
                                                                  SelectedItem="{Binding Wert}"
                                                                  AutomationProperties.Name="{Binding Name}"
                                                                  Visibility="{Binding HatAuswahl, Converter={StaticResource BoolZuSichtbarkeit}}" />

                                                        <TextBox Style="{StaticResource Eingabefeld}"
                                                                 Text="{Binding Wert, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                                                 AutomationProperties.Name="{Binding Name}"
                                                                 Visibility="{Binding HatTextfeld, Converter={StaticResource BoolZuSichtbarkeit}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Ergebnis: die Zeile, die in die PowerShell gehoert -->
                                <TextBlock Text="Aufrufzeile"
                                           FontSize="11"
                                           Margin="0,8,0,5"
                                           Foreground="{StaticResource Text.Gedaempft}" />
                                <TextBox Text="{Binding DataContext.Aufrufzeile,
                                                        RelativeSource={RelativeSource AncestorType=Window},
                                                        Mode=OneWay}"
                                         Style="{StaticResource Eingabefeld}"
                                         AutomationProperties.Name="Erzeugte Aufrufzeile"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Background="{StaticResource Flaeche.Code}"
                                         FontFamily="{StaticResource Schrift.Code}"
                                         Foreground="{StaticResource Syntax.Parameter}" />

                                <TextBlock Text="{Binding DataContext.FehlendeAngaben,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="11.5"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Akzent.Warnung}"
                                           Visibility="{Binding DataContext.HatFehlendeAngaben,
                                                                RelativeSource={RelativeSource AncestorType=Window},
                                                                Converter={StaticResource BoolZuSichtbarkeit}}" />

                                <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                    <Button Content="Aufrufzeile kopieren"
                                            Style="{StaticResource Schaltflaeche.Primaer}"
                                            Command="{Binding DataContext.AufrufKopierenBefehl,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Eingaben leeren"
                                            Style="{StaticResource Schaltflaeche.Sekundaer}"
                                            Command="{Binding DataContext.ParameterLeerenBefehl,
                                                              RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource Flaeche.Code}"
                            BorderBrush="{StaticResource Linie.Standard}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,8,8"
                            MinHeight="90">
                        <RichTextBox views:PowerShellHervorhebung.Quelltext="{Binding Inhalt}"
                                     IsReadOnly="True"
                                     IsDocumentEnabled="False"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="20,16"
                                     FontFamily="{StaticResource Schrift.Code}"
                                     FontSize="12.5"
                                     Foreground="{StaticResource Syntax.Standard}"
                                     SelectionBrush="{StaticResource Akzent.Primaer}"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Statusleiste ============ -->
        <Border Grid.Row="4"
                Background="{StaticResource Flaeche.Kopf}"
                BorderBrush="{StaticResource Linie.Standard}"
                BorderThickness="0,1,0,0"
                Padding="28,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding TrefferText}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Sekundaer}" />
                    <TextBlock FontSize="12"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Akzent.Warnung}"
                               Text="{Binding FavoritenAnzahl, StringFormat=★ {0} Favoriten}" />

                    <!-- Der Paketbereich erscheint erst, wenn etwas ausgewaehlt ist -
                         solange die Auswahl leer ist, waere er nur Rauschen. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="18,0,0,0"
                                Visibility="{Binding HatPaket, Converter={StaticResource BoolZuSichtbarkeit}}">
                        <TextBlock Text="{Binding PaketText}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Akzent.Primaer}" />
                        <Button Content="Paket erzeugen"
                                Style="{StaticResource Schaltflaeche.Primaer}"
                                Command="{Binding PaketErzeugenBefehl}"
                                Padding="12,4"
                                FontSize="12"
                                Margin="12,0,0,0"
                                ToolTip="Die ausgewählten Skripte als Ordner mit Läufer und Bericht ablegen" />
                        <Button Content="Auswahl leeren"
                                Style="{StaticResource Schaltflaeche.Sekundaer}"
                                Command="{Binding PaketLeerenBefehl}"
                                Padding="12,4"
                                FontSize="12"
                                Margin="7,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding Statusmeldung}"
                           FontSize="12"
                           Margin="18,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Akzent.Erfolg}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding KatalogInfo}"
                           FontSize="12"
                           Foreground="{StaticResource Text.Gedaempft}" />
            </Grid>
        </Border>
    </Grid>
</Window>
