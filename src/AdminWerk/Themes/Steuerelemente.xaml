<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Schaltflaechen ===================== -->

    <Style x:Key="Schaltflaeche.Basis" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Schrift.Oberflaeche}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Rahmen"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Rahmen" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Rahmen" Property="Opacity" Value="0.70" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Rahmen" Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Schaltflaeche.Primaer" TargetType="Button" BasedOn="{StaticResource Schaltflaeche.Basis}">
        <Setter Property="Background" Value="{StaticResource Akzent.Primaer}" />
        <Setter Property="BorderBrush" Value="{StaticResource Akzent.Primaer}" />
        <Setter Property="Foreground" Value="#0B1220" />
    </Style>

    <Style x:Key="Schaltflaeche.Sekundaer" TargetType="Button" BasedOn="{StaticResource Schaltflaeche.Basis}">
        <Setter Property="Background" Value="{StaticResource Flaeche.Erhoben}" />
        <Setter Property="BorderBrush" Value="{StaticResource Linie.Betont}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primaer}" />
    </Style>

    <!-- ===================== Favoritenstern ===================== -->

    <!-- Reiner Glyph-Schalter fuer die Skriptliste. Das Zeichen kommt aus dem Trigger. -->
    <Style x:Key="Schaltflaeche.Stern" TargetType="Button">
        <Setter Property="Content" Value="☆" />
        <Setter Property="Foreground" Value="{StaticResource Text.Gedaempft}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="8,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ToolTip" Value="Als Favorit merken (Strg+D)" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Reihenfolge zaehlt: der Favoritenzustand soll den Hover-Zustand uebersteuern. -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Akzent.Hell}" />
            </Trigger>
            <DataTrigger Binding="{Binding IstFavorit}" Value="True">
                <Setter Property="Content" Value="★" />
                <Setter Property="Foreground" Value="{StaticResource Akzent.Warnung}" />
                <Setter Property="ToolTip" Value="Favorit entfernen (Strg+D)" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Beschriftete Variante fuer den Detailbereich. -->
    <Style x:Key="Schaltflaeche.Favorit" TargetType="Button" BasedOn="{StaticResource Schaltflaeche.Basis}">
        <Setter Property="Background" Value="{StaticResource Flaeche.Erhoben}" />
        <Setter Property="BorderBrush" Value="{StaticResource Linie.Betont}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Sekundaer}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IstFavorit}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Akzent.Warnung}" />
                <Setter Property="Foreground" Value="{StaticResource Akzent.Warnung}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Suchfeld ===================== -->

    <Style x:Key="Suchfeld" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Schrift.Oberflaeche}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primaer}" />
        <Setter Property="CaretBrush" Value="{StaticResource Akzent.Primaer}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Akzent.Primaer}" />
        <Setter Property="Background" Value="{StaticResource Flaeche.Fenster}" />
        <Setter Property="BorderBrush" Value="{StaticResource Linie.Standard}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Rahmen"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Akzent.Primaer}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Kategorie-Navigation ===================== -->

    <Style x:Key="Kategorieleiste" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid>
                                    <Border x:Name="Rahmen"
                                            Background="Transparent"
                                            CornerRadius="6,6,0,0"
                                            Padding="16,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Symbol"
                                                       Text="{Binding Symbol}"
                                                       FontSize="13"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Text.Gedaempft}" />
                                            <TextBlock x:Name="Beschriftung"
                                                       Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Text.Sekundaer}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="Unterstrich"
                                            Height="2"
                                            VerticalAlignment="Bottom"
                                            Background="Transparent" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Beschriftung" Property="Foreground" Value="{StaticResource Text.Primaer}" />
                                        <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource Flaeche.Karte}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Beschriftung" Property="Foreground" Value="{StaticResource Text.Primaer}" />
                                        <Setter TargetName="Symbol" Property="Foreground" Value="{StaticResource Akzent.Primaer}" />
                                        <Setter TargetName="Unterstrich" Property="Background" Value="{StaticResource Akzent.Primaer}" />
                                        <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource Flaeche.Karte}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Skriptliste ===================== -->

    <Style x:Key="Skriptliste" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Rahmen"
                                        Background="{StaticResource Flaeche.Karte}"
                                        BorderBrush="{StaticResource Linie.Standard}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,11">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Linie.Betont}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Rahmen" Property="Background" Value="{StaticResource Flaeche.Erhoben}" />
                                        <Setter TargetName="Rahmen" Property="BorderBrush" Value="{StaticResource Akzent.Primaer}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Kennzeichnung (Badge) ===================== -->

    <Style x:Key="Kennzeichen" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Background" Value="{StaticResource Flaeche.Erhoben}" />
        <Setter Property="BorderBrush" Value="{StaticResource Linie.Standard}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Kennzeichen.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text.Sekundaer}" />
    </Style>

    <!-- ===================== Bildlaufleisten ===================== -->

    <Style TargetType="Thumb" x:Key="Bildlauf.Griff">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource Linie.Betont}"
                            CornerRadius="4"
                            Margin="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Bildlauf.Griff}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Bildlauf.Griff}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
